<form class="{{cssClass}}" autocomplete="off">
  <nav class="flexrow tabbed round" data-group="primary" id="competency-tabs">
    <ul>
      <li data-tab="main">
        <span class="color-blue" style="margin-right: 3px">&#9650;</span>
        {{localize "TYPES.Item.Anomaly"}}
      </li>
    </ul>
  </nav>

  <div class="tab-content flexrow manilla-folder">
    <div class="tab active" data-group="primary" data-tab="main">
      <div style="height: 600px">
        <div class="tab-workarea">
          <div style="font-size: 1.8em; width: 100%">
            <input name="name" type="text" value="{{item.name}}" placeholder="Anomaly name"/>
          </div>

          <div style="height: 150px; width: 100%">
            {{editor
            system.description
            target="system.description"
            engine="prosemirror"
            button=true
            editable=editable
            }}
          </div>
        </div>

        <fieldset id="abilities" class="agency" style="height: 395px; width: 100%; margin: 10px 0 8px 0">
          <legend>&nbsp;{{localize "TA.Abilities"}}&nbsp;</legend>
          <div style="display: grid; grid-template-columns: 170px auto; gap: 0 10px; width: 100%;">
            <div style="width: 100%; height: 360px; overflow: auto">
              <nav class="abilities-nav sidenav flexrow" data-group="abilities">
                <ul class="articulat-bold" style="list-style-type: none; padding: 0; margin: 0;">
                  {{#each extra.abilities}}
                    <li data-tab="{{this.id}}" style="padding: 4px; cursor: pointer;{{#if this.reference}}color:#2752A2;{{/if}}">
                      {{this.name}}
                    </li>
                  {{/each}}              
                </ul>
              </nav>
            </div>
            <div class="abilities-content flexrow" style="height: 360px; overflow: auto">
              {{#each extra.abilities}}
                <div class="tab" data-group="abilities" data-tab="{{this.id}}" style="padding: 5px 2px">
                  <div style="font-size: 1.1em">
                    <span class="articulat-bold">{{this.name}}</span>
                    {{#if this.reference}}
                      <span class="articulat color-white" style="float: right; padding: 0 8px; background-color: #2752A2;">{{this.reference}}</span>
                    {{/if}}
                  </div>
                  <div>
                    {{{this.rendered}}}
                  </div>
                </div>
              {{/each}}              
            </div>
          </div>
        </fieldset>
      </div>
    </div>
  </div>
</form>